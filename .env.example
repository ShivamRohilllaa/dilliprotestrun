# Copy to .env.local or set these variables in your hosting provider, then rebuild.
# All VITE_ variables are public. Never put passwords or API secrets here.

# Public homepage URL for canonical, social sharing, robots.txt and sitemap.xml.
# Include the deployment path when hosting in a subdirectory.
VITE_SITE_URL=https://example.com/

# Shared live player counter. Requires the Node service and Nginx proxy in docs/LIVE_PLAYERS.md.
# Set false for static-only deployments that do not run the presence API.
VITE_PRESENCE_ENABLED=true
